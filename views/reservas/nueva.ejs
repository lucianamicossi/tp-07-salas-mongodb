<section class="pagina">

  <h2><%= seccion %></h2>

  <h3>Nueva reserva</h3>

  <% if (typeof error !== "undefined" && error) { %>

    <div class="mensaje-error" role="alert">
      <strong>No se pudo crear la reserva.</strong>

      <p><%= error %></p>
    </div>

  <% } %>

  <form action="/reservas" method="POST">

    <div class="campo">
      <label for="estudiante">
        Estudiante
      </label>

      <input
        type="text"
        id="estudiante"
        name="estudiante"
        value="<%= datos.estudiante %>"
        required
      >
    </div>

    <div class="campo">
      <label for="email">
        Email
      </label>

      <input
        type="email"
        id="email"
        name="email"
        value="<%= datos.email %>"
        required
      >
    </div>

    <div class="campo">
      <label for="sala">
        Sala
      </label>

      <select
        id="sala"
        name="sala"
        required
      >

        <option value="">
          Seleccioná una sala
        </option>

        <% salasPermitidas.forEach((sala) => { %>

          <option
            value="<%= sala %>"
            <%= datos.sala === sala ? "selected" : "" %>
          >
            <%= sala %>
          </option>

        <% }) %>

      </select>
    </div>

    <div class="campo">
      <label for="fecha">
        Fecha
      </label>

      <input
        type="date"
        id="fecha"
        name="fecha"
        value="<%= datos.fecha %>"
        required
      >
    </div>

    <div class="campo">

        <p class="titulo-campo">Turno</p>

    <fieldset class="grupo-turno">

      <legend class="sr-only">Turno</legend>

      <% turnosPermitidos.forEach((turno) => { %>

        <div class="opcion">

          <input
            type="radio"
            id="turno-<%= turno.toLowerCase() %>"
            name="turno"
            value="<%= turno %>"
            <%= datos.turno === turno ? "checked" : "" %>
            required
          >

          <label for="turno-<%= turno.toLowerCase() %>">
            <%= turno %>
          </label>

        </div>

      <% }) %>

    </fieldset>

    </div>

    <div class="campo">

      <label for="personas">
        Cantidad de personas
      </label>

      <input
        type="number"
        id="personas"
        name="personas"
        min="1"
        max="6"
        value="<%= datos.personas %>"
        required
      >

      <small>
        La cantidad permitida es de 1 a 6 personas.
      </small>

    </div>

    <div class="acciones">

      <button type="submit" class="boton">
        Crear reserva
      </button>

      <a href="/reservas" class="boton boton-secundario">
        Cancelar
      </a>

    </div>

  </form>

</section>