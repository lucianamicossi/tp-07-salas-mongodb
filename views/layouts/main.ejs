<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= titulo %> | Salas de estudio</title>

  <link rel="stylesheet" href="/css/estilos.css">
</head>

<body>

  <header class="encabezado">
    <div class="contenedor">
      <h1>Salas de estudio</h1>

      <nav aria-label="Navegación principal">
        <ul class="navegacion">
          <li>
            <a href="/">Inicio</a>
          </li>

          <li>
            <a href="/reservas">Reservas</a>
          </li>

          <li>
            <a href="/reservas/nueva">Nueva reserva</a>
          </li>

          <li>
            <a href="/estado">Estado</a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="contenedor">
    <%- body %>
  </main>

  <footer class="pie">
    <div class="contenedor">
      <p>Sistema de reservas de salas de estudio</p>

      <% if (typeof solicitudId !== "undefined") { %>
        <small>Solicitud: <%= solicitudId %></small>
      <% } %>
    </div>
  </footer>

</body>
</html>